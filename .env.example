# ─────────────────────────────────────────────────────────────────────────────
# Networks
# ─────────────────────────────────────────────────────────────────────────────
BASE_RPC_URL=
BASE_SEPOLIA_RPC_URL=
BASESCAN_API_KEY=

# Monad mainnet: chain ID 143, https://rpc.monad.xyz
# Monad testnet: chain ID 10143, https://testnet-rpc.monad.xyz
MONAD_RPC_URL=
MONAD_TESTNET_RPC_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Signing key — deployer only
# ─────────────────────────────────────────────────────────────────────────────
# Hot and disposable. Receives NO role: every _grantRole in the deploy path
# targets ADMIN_ADDRESS / OPERATOR_ADDRESS, never msg.sender. Needs gas only.
# Not read by the scripts — passed via --private-key on the command line.
DEPLOYER_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Role addresses — MUST be two distinct values, and neither should be the
# deployer. Sharing one address between them defeats the point of the role
# split: a leaked operator key would also carry upgrade authority, and the
# rotation path (ADMIN grants OPERATOR to a new address) would be unusable.
# ─────────────────────────────────────────────────────────────────────────────
# COLD. DEFAULT_ADMIN_ROLE + ADMIN_ROLE on all contracts: upgrade authority,
# role rotation, transfer whitelist, payment token, schemas. Signs nothing
# during deployment, so a Safe multisig address works here from day one.
ADMIN_ADDRESS=

# HOT. OPERATOR_ROLE: createIssuerToken, recordDistribution, attest*.
# Lives in the backend secrets manager and signs unattended.
OPERATOR_ADDRESS=

# ─────────────────────────────────────────────────────────────────────────────
# Attestation layer
# ─────────────────────────────────────────────────────────────────────────────
# On chains running canonical EAS (Base, Optimism, Arbitrum, …): use the
# official EAS + SchemaRegistry addresses, then run RegisterSchema.s.sol.
#
# On chains without EAS (Monad, as of 2026-08): run DeployAttestationStack.s.sol,
# which deploys SahihSchemaRegistry + SahihAttestationRegistry and registers all
# three schemas in one transaction batch, then paste its output below.
EAS_SCHEMA_REGISTRY_ADDRESS=
EAS_ADDRESS=
VERIFICATION_SCHEMA_UID=
SCORE_SCHEMA_UID=
DISTRIBUTION_SCHEMA_UID=

# ─────────────────────────────────────────────────────────────────────────────
# Deployment inputs
# ─────────────────────────────────────────────────────────────────────────────
# ERC20 the Distribution contract pays holders in. Must be a plain,
# non-rebasing, non-fee-on-transfer token: payouts assume safeTransfer
# delivers exactly the recorded amount, and any shortfall would silently
# contradict the totalAmount recorded on-chain and attested.
#
# For a testnet demo, run DeployDemoPaymentToken.s.sol and paste its address
# here. That token has 0 decimals (1 unit = Rp1) and lets ANYONE mint without
# limit — testnet only, never point this at it on a network with real money.
PAYMENT_TOKEN_ADDRESS=

# Optional overrides for the demo token's metadata.
DEMO_TOKEN_NAME=
DEMO_TOKEN_SYMBOL=

# ─────────────────────────────────────────────────────────────────────────────
# Deployed addresses — filled in from Deploy.s.sol output
# ─────────────────────────────────────────────────────────────────────────────
FACTORY_ADDRESS=
DISTRIBUTION_PROXY=
ATTESTER_PROXY=

# ─────────────────────────────────────────────────────────────────────────────
# Upgrades
# ─────────────────────────────────────────────────────────────────────────────
# UPGRADE_REFERENCE_CONTRACT is REQUIRED, not optional: Upgrades.upgradeProxy
# always validates against a previous version. Give it the old contract as
# "File.sol:Contract" (e.g. IssuerToken.sol:IssuerToken).
#
# Run `forge clean && forge build` first — the validator reads out/build-info
# and fails with "Found multiple contracts" if stale build info is present.
UPGRADE_PROXY_ADDRESS=
UPGRADE_CONTRACT_NAME=
UPGRADE_REFERENCE_CONTRACT=

# Windows only: the OZ upgrades plugin shells out via bash. Without this it
# picks up WSL bash and fails with "WSL 1 is not supported".
# OPENZEPPELIN_BASH_PATH="C:/Program Files/Git/bin/bash"
OPENZEPPELIN_BASH_PATH=
